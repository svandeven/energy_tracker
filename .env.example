# Copy to `.env` and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
# The anon/publishable key is safe to ship in a mobile bundle; access is
# constrained by the row-level security policies in supabase/schema.sql.
# Do NOT put the service_role key in this file.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
