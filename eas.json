{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "ios": { "resourceClass": "default" },
      "android": { "buildType": "apk" }
    },
    "simulator": {
      "extends": "preview",
      "ios": { "simulator": true }
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "ios": { "image": "latest" }
    }
  },
  "submit": {
    "production": {}
  }
}
